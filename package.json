{
  "name": "motion-bench",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "check": "vp check",
    "test": "vp test",
    "tauri": "tauri",
    "test:ui": "playwright test",
    "build:e2e": "tauri build --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json -- --target-dir ../target/e2e",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "audit": "fallow audit",
    "dupes": "jscpd",
    "fixture": "cargo test --manifest-path src-tauri/Cargo.toml --features developer-tools write_the_ui_fixture -- --ignored"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "lucide-react": "^0.577",
    "motion": "^14.3.0",
    "radix-ui": "^1.6.7",
    "react": "^19",
    "react-dom": "^19",
    "sonner": "2.0.8",
    "tailwind-merge": "^3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@shadcn/lint": "^0.2.0",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.4.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "fallow": "3.32.0",
    "jscpd": "5.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vite-plus": "1.2.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0"
  }
}
