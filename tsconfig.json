{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "paths": { "@/*": ["./ui/*"] },
    "types": ["bun"]
  },
  "include": [
    "tests/ui",
    "tests/e2e",
    "ui",
    "tests/unit",
    "tools",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
